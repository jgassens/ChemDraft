{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChemDraft",
  "version": "1.1.1",
  "identifier": "org.chemdraft.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "ChemDraft",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "acceptFirstMouse": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/avogadro3d-sidecar"],
    "resources": {
      "resources/opsin/*.jar": "resources/opsin",
      "resources/opsin/*.txt": "resources/opsin",
      "resources/opsin/jre": "resources/opsin/jre",
      "resources/ocsr/*.py": "resources/ocsr",
      "resources/ocsr/*.txt": "resources/ocsr",
      "resources/naming": "resources/naming",
      "../../../NOTICE": "licenses/NOTICE",
      "../../../LICENSE": "licenses/LICENSE",
      "../../../packages/export-engine/src/fonts/LICENSE_NOTO.txt": "licenses/LICENSE_NOTO.txt",
      "../../../packages/export-engine/src/fonts/LICENSE_DEJAVU.txt": "licenses/LICENSE_DEJAVU.txt"
    },
    "fileAssociations": [
      {
        "ext": ["chemdraft"],
        "name": "ChemDraft Document",
        "description": "ChemDraft CDXML document",
        "mimeType": "chemical/x-cdxml",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "org.chemdraft.document",
          "conformsTo": ["public.xml"]
        }
      },
      {
        "ext": ["cdxml"],
        "name": "CDXML Document",
        "description": "Chemical Markup Language document",
        "mimeType": "chemical/x-cdxml",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": ["com.cambridgesoft.cdxml", "public.xml"]
      },
      {
        "ext": ["cdx"],
        "name": "CDX Document",
        "description": "Binary chemical drawing document",
        "mimeType": "chemical/x-cdx",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": ["com.cambridgesoft.chemdraw.cdx", "public.data"]
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "frameworks": ["./Sparkle.framework"],
      "entitlements": "./chemdraft.entitlements"
    }
  }
}
