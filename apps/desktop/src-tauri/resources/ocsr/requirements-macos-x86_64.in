# Intel Mac (macOS x86_64) input; Python stays 3.10 and NumPy stays 1.26.4.
# torch 2.2.2 is the last release with Intel Mac wheels; torchvision 0.17.2 matches it.
# rdkit 2023.9.6 supplies the compatible Python 3.10 Intel Mac wheel.
# opencv-python and opencv-python-headless 4.9.0.80 keep macOS 11 support:
# their 4.11 Intel wheels require macOS 13.
# All other versions are retained from requirements.txt in the exact pins below.
# Re-lock from this directory with exactly:
#
#   uv pip compile requirements-macos-x86_64.in --python-version 3.10 --python-platform x86_64-apple-darwin --generate-hashes -o requirements-macos-x86_64.txt
#
# Then set REQUIREMENTS_LOCK_SHA256_MACOS_X86_64 in src/ocsr_engine/pins.rs
# to the LF-normalized lock SHA-256; the lock-hash test fails until it matches.
# See docs/architecture/ocsr-engine.md.

# The reviewed engine versions.
torch==2.2.2
torchvision==0.17.2
numpy==1.26.4

# MolScribe's own install_requires (setup.py at 7296a30413eb55436702011efdff78131f66d162).
# MolScribe itself is installed afterwards, with --no-deps, from its SHA-256-verified tarball.
numpy>=1.19.5,<2.0
