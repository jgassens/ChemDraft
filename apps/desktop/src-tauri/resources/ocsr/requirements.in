# Input to the hash-locked requirements.txt beside it. Edit this file, then re-lock:
#
#   uv pip compile requirements.in --universal --python-version 3.10 --generate-hashes \
#     -o requirements.txt
#
# (uv keeps the versions already in requirements.txt unless told --upgrade.) Then update
# REQUIREMENTS_LOCK_SHA256 in src/ocsr_engine/pins.rs; a test fails until it matches.
# See docs/architecture/ocsr-engine.md.

