{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "runtime-host-services",
  "description": "Sole hidden runtime: scoped plugin storage/staging, fixed release URLs and existing engine controllers. Native file pickers remain in the document; image reads require their chosen-file scope. No generic emit, window, menu, session, clipboard or document-write grants.",
  "windows": [
    "runtime"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-plugin-storage-read",
    "allow-plugin-storage-write",
    "allow-plugin-storage-delete",
    "allow-opsin-status",
    "allow-opsin-name-to-structure",
    "allow-read-plugin-package",
    "allow-diagnose-download-host",
    "allow-naming-engine-status",
    "allow-naming-engine-install",
    "allow-naming-engine-cancel-install",
    "allow-naming-engine-uninstall",
    "allow-name-structure-raw",
    "allow-naming-cancel",
    "allow-ocsr-engine-status",
    "allow-ocsr-engine-install",
    "allow-ocsr-engine-cancel-install",
    "allow-ocsr-engine-uninstall",
    "allow-ocsr-recognize-image",
    "allow-ocsr-recognize-cancel",
    "allow-external-tool-status",
    "allow-external-tool-install",
    "allow-external-tool-cancel-install",
    "allow-external-tool-uninstall",
    "allow-external-tool-sign-in",
    "allow-external-tool-consent-set",
    "allow-external-tool-consent-list",
    "allow-external-tool-consent-revoke",
    "allow-external-tool-consent-clear-plugin",
    "allow-external-tool-run-start",
    "allow-external-tool-run-poll",
    "allow-external-tool-run-cancel",
    "allow-external-tool-conversation-clear",
    "allow-assistant-mcp-session-open",
    "allow-assistant-mcp-session-close",
    "allow-assistant-mcp-respond",
    "allow-assistant-mcp-status",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-NMR-Plugin/releases/latest"
        },
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-NMR-Plugin/releases?per_page=20"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-NMR-Plugin/releases/download/*/nmr-predictor-*.zip"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-NMR-Plugin/releases/download/*/nmr-predictor-*.zip.sha256"
        },
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-OPSIN-Plugin/releases/latest"
        },
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-OPSIN-Plugin/releases?per_page=20"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-OPSIN-Plugin/releases/download/*/opsin-name-to-structure-*.zip"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-OPSIN-Plugin/releases/download/*/opsin-name-to-structure-*.zip.sha256"
        },
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-MolScribe-Plugin/releases/latest"
        },
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-MolScribe-Plugin/releases?per_page=20"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-MolScribe-Plugin/releases/download/*/molscribe-ocsr-*.zip"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-MolScribe-Plugin/releases/download/*/molscribe-ocsr-*.zip.sha256"
        },
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-Orthonym-Plugin/releases/latest"
        },
        {
          "url": "https://api.github.com/repos/jgassens/ChemDraft-Orthonym-Plugin/releases?per_page=20"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-Orthonym-Plugin/releases/download/*/orthonym-naming-*.zip"
        },
        {
          "url": "https://github.com/jgassens/ChemDraft-Orthonym-Plugin/releases/download/*/orthonym-naming-*.zip.sha256"
        },
        {
          "url": "https://release-assets.githubusercontent.com/github-production-release-asset/*"
        }
      ]
    },
    "allow-screen-capture-available",
    "allow-screen-capture-permission-status",
    "allow-request-screen-capture-permission",
    "allow-open-screen-capture-settings",
    "allow-capture-screen-region",
    "allow-relaunch-app",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/installed-plugins.json"
        },
        {
          "path": "$APPDATA/installed-plugins.json.tmp"
        },
        {
          "path": "$APPDATA/installed-plugins"
        },
        {
          "path": "$APPDATA/installed-plugins/**"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-stat"
  ]
}
