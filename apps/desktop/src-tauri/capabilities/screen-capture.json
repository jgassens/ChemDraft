{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screen-capture",
  "description": "Allow only the main document window to query and invoke host-owned screen-region capture, and to keep and show the captures behind accepted recognitions.",
  "windows": ["main"],
  "permissions": [
    "allow-screen-capture-available",
    "allow-screen-capture-permission-status",
    "allow-request-screen-capture-permission",
    "allow-open-screen-capture-settings",
    "allow-capture-screen-region",
    "allow-relaunch-app",
    "allow-retain-recognition-screen-capture",
    "allow-reveal-recognition-screen-captures"
  ]
}
