{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "office-toolset",
  "description": "Palettes and popovers owned by an embedded Office drawing.",
  "platforms": [
    "windows"
  ],
  "windows": [
    "office-utility-office-object-*--toolset-core-*",
    "office-utility-office-object-*--toolset-popover-*"
  ],
  "permissions": [
    "allow-office-toolset-emit",
    "core:window:allow-get-all-windows",
    "core:window:allow-is-visible",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-focus",
    "allow-close-toolset-window",
    "allow-list-toolset-window-states",
    "allow-open-toolset-popover",
    "allow-close-toolset-popover",
    "allow-prewarm-toolset-popover",
    "allow-prewarm-toolset-tooltip",
    "allow-show-toolset-popover-window",
    "allow-window-logical-position",
    "allow-current-window-logical-work-area",
    "allow-monitor-logical-bounds-at",
    "allow-clamp-current-inspector-frame",
    "allow-resize-toolset-window",
    "allow-start-window-drag",
    "allow-route-toolset-command",
    "allow-register-plugin-panel-input-focus",
    "allow-set-plugin-panel-input-focus",
    "allow-set-palette-command-hit-boxes",
    "allow-list-system-fonts",
    "allow-set-current-window-global-position"
  ]
}
