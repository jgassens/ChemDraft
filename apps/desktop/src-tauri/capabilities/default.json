{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-and-tool-palette",
  "description": "Allow the ChemDraft document window and native toolset windows to use core window/event APIs and the narrow toolset command bridge.",
  "windows": [
    "main",
    "tool-palette",
    "toolset-core-main",
    "toolset-core-structure",
    "toolset-core-arrows",
    "toolset-core-annotations",
    "toolset-core-text",
    "toolset-core-orbitals",
    "toolset-core-layout",
    "toolset-core-style",
    "toolset-plugin-fixture",
    "spin3d-debugger",
    "preferences"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:webview:allow-set-webview-focus",
    "allow-open-toolset-window",
    "allow-close-toolset-window",
    "allow-focus-toolset-window",
    "allow-toggle-toolset-window",
    "allow-list-toolset-window-states",
    "allow-focus-main-document-window",
    "allow-route-toolset-command",
    "allow-read-clipboard-payload",
    "allow-open-tool-palette",
    "allow-close-tool-palette",
    "allow-focus-tool-palette",
    "allow-toggle-tool-palette",
    "allow-tool-palette-state",
    "allow-route-palette-command",
    "allow-toggle-spin3d-debugger-window",
    "allow-toggle-preferences-window",
    "allow-rasterize-svg",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$TEMP/**" }
      ]
    }
  ]
}
