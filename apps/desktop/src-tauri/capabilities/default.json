{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-and-tool-palette",
  "description": "Allow the ChemDraft document window and native toolset windows to use core window/event APIs and the narrow toolset command bridge.",
  "windows": [
    "main",
    "toolset-*",
    "plugin-panel-*",
    "spin3d-debugger",
    "preferences"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:webview:allow-set-webview-focus",
    "allow-open-toolset-window",
    "allow-close-toolset-window",
    "allow-list-toolset-window-states",
    "allow-load-toolset-customization-state",
    "allow-save-toolset-customization-state",
    "allow-set-toolbars-menu",
    "allow-focus-main-document-window",
    "allow-set-menu-checked",
    "allow-plugin-storage-read",
    "allow-plugin-storage-write",
    "allow-open-plugin-panel-window",
    "allow-open-toolset-popover",
    "allow-close-toolset-popover",
    "core:window:allow-hide",
    "allow-route-toolset-command",
    "allow-read-clipboard-payload",
    "allow-write-clipboard-text-items",
    "allow-toggle-spin3d-debugger-window",
    "allow-toggle-preferences-window",
    "allow-engine3d-sidecar-status",
    "allow-engine3d-sidecar-start-session",
    "allow-engine3d-sidecar-send-session",
    "allow-engine3d-sidecar-poll-session",
    "allow-engine3d-sidecar-stop-session",
    "allow-rasterize-svg",
    "allow-list-system-fonts",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$TEMP/**" }
      ]
    }
  ]
}
