{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "office-tooltip",
  "description": "Tooltip renderer for palettes owned by an embedded Office drawing.",
  "platforms": [
    "windows"
  ],
  "windows": [
    "office-utility-office-object-*--toolset-tooltip"
  ],
  "permissions": [
    "core:window:allow-set-size",
    "allow-show-toolset-tooltip-window",
    "allow-hide-toolset-tooltip-window",
    "allow-monitor-logical-bounds-at"
  ]
}
