    "@chemdraft/chemistry-adapter": "workspace:*",
    "@chemdraft/clipboard-adapter": "workspace:*",
    "@chemdraft/editor-adapter": "workspace:*",
    "@chemdraft/engine3d-api": "workspace:*",
    "@chemdraft/export-engine": "workspace:*",
    "@chemdraft/isospec-adapter": "workspace:*",
    "@chemdraft/ketcher-adapter": "workspace:*",
    "@chemdraft/layout-engine": "workspace:*",
    "@chemdraft/molscribe-ocsr-plugin": "workspace:*",
    "@chemdraft/ocl-adapter": "workspace:*",
    "@chemdraft/plugin-api": "workspace:*",
    "@chemdraft/plugin-host": "workspace:*",
    "@chemdraft/plugin-mass-fragment": "workspace:*",
    "@chemdraft/rdkit-adapter": "workspace:*",
    "@chemdraft/shortcut-engine": "workspace:*",
    "@chemdraft/style-compat": "workspace:*",
    "@chemdraft/toolset-registry": "workspace:*",
    "@chemdraft/viewport-engine": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jaames/iro": "^5.5.2",
    "@scena/react-ruler": "^0.19.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "ketcher-react": "^3.12.0",
    "ketcher-standalone": "^3.12.0",
    "openchemlib": "^9.22.1",
    "raphael": "^2.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "vite": "^7.0.0"
  }
