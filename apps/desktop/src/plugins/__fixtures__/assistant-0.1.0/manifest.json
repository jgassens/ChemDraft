{
  "id": "org.chemdraft.assistant",
  "name": "ChemDraft Assistant",
  "version": "0.1.0",
  "apiVersion": "^0.1.10",
  "entry": "entry.js",
  "permissions": [
    "ui.menu",
    "ui.panel",
    "ui.canvas",
    "plugin.storage",
    "document.read",
    "document.write",
    "selection.read",
    "chemistry.compute",
    "native.execute",
    "assistant.run"
  ],
  "contributes": {
    "commands": [
      {
        "id": "plugin.assistant.open",
        "title": "Open ChemDraft Assistant",
        "requiredPermissions": [],
        "enabled": true
      },
      {
        "id": "plugin.assistant.submit",
        "title": "Send to ChemDraft Assistant",
        "requiredPermissions": [],
        "enabled": true
      },
      {
        "id": "plugin.assistant.stop",
        "title": "Stop assistant",
        "requiredPermissions": [],
        "enabled": true
      },
      {
        "id": "plugin.assistant.setProvider",
        "title": "Set assistant provider",
        "requiredPermissions": [],
        "enabled": true
      },
      {
        "id": "plugin.assistant.install",
        "title": "Install assistant provider",
        "requiredPermissions": [],
        "enabled": true
      },
      {
        "id": "plugin.assistant.signIn",
        "title": "Sign in to assistant provider",
        "requiredPermissions": [],
        "enabled": true
      },
      {
        "id": "plugin.assistant.newConversation",
        "title": "New assistant conversation",
        "requiredPermissions": [],
        "enabled": true
      }
    ],
    "menus": [
      {
        "id": "menu.assistant.open",
        "title": "ChemDraft Assistant…",
        "commandId": "plugin.assistant.open",
        "location": "plugins",
        "requiredPermissions": [
          "ui.menu"
        ]
      }
    ],
    "panels": [
      {
        "id": "panel.assistant.chat",
        "title": "ChemDraft Assistant",
        "preferredWindowSize": {
          "width": 440,
          "height": 640
        },
        "requiredPermissions": [
          "ui.panel"
        ]
      }
    ],
    "canvasOverlays": [
      {
        "id": "overlay.assistant.prompt",
        "title": "ChemDraft Assistant",
        "icon": "data:image/svg+xml;base64,",
        "commandId": "plugin.assistant.submit",
        "prompt": {
          "kind": "prompt",
          "id": "message",
          "commandId": "plugin.assistant.submit",
          "placeholder": "Ask the assistant to draw or change something…",
          "submitLabel": "Send",
          "maxLength": 4000,
          "rows": 2,
          "disabled": false,
          "select": {
            "id": "provider",
            "label": "AI",
            "value": "claude-code",
            "options": [
              {
                "value": "claude-code",
                "label": "Claude Code"
              },
              {
                "value": "codex",
                "label": "Codex"
              }
            ],
            "commandId": "plugin.assistant.setProvider"
          }
        },
        "defaultCorner": "bottom-right",
        "requiredPermissions": [
          "ui.canvas"
        ]
      }
    ],
    "toolbarButtons": [],
    "toolsets": [],
    "inspectors": [],
    "templates": [],
    "importers": [],
    "exporters": [],
    "analyzers": [],
    "transformers": [],
    "recognizers": []
  },
  "chemdraftPackage": {
    "sdk": "@chemdraft/plugin-api",
    "sdkVersion": "0.1.10",
    "sourceCommit": "247ec7297218d4781032a670ac4b48b58ef5dbb2",
    "sourceTree": "clean",
    "licenseFile": "LICENSE",
    "packagedAt": "2026-10-23T20:39:26.384Z"
  }
}
