<?xml version="1.0" encoding="UTF-8"?>
<!-- The build:office script fills the version fields. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="TaskPaneApp">
  <Id>c2b05f5c-0724-4438-bff6-229da8041c57</Id>
  <Version>{{ManifestVersion}}</Version>
  <ProviderName>ChemDraft</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Edit Structure"/>
  <Description DefaultValue="Edit a ChemDraft structure picture in Word or PowerPoint."/>
  <IconUrl DefaultValue="https://chemdraft.ai/office/{{AppVersion}}/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://chemdraft.ai/office/{{AppVersion}}/icon-80.png"/>
  <SupportUrl DefaultValue="https://chemdraft.ai/"/>
  <Hosts>
    <Host Name="Document"/>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://chemdraft.ai/office/{{AppVersion}}/taskpane"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
                    xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="ChemDraft.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="ChemDraft.Word">
                <Label resid="ChemDraft.Label"/>
                <Icon>
                  <bt:Image size="16" resid="ChemDraft.Icon16"/>
                  <bt:Image size="32" resid="ChemDraft.Icon32"/>
                  <bt:Image size="80" resid="ChemDraft.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="ChemDraft.Word.Open">
                  <Label resid="ChemDraft.Label"/>
                  <Supertip>
                    <Title resid="ChemDraft.Label"/>
                    <Description resid="ChemDraft.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ChemDraft.Icon16"/>
                    <bt:Image size="32" resid="ChemDraft.Icon32"/>
                    <bt:Image size="80" resid="ChemDraft.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ChemDraftEditStructure</TaskpaneId>
                    <SourceLocation resid="ChemDraft.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <FunctionFile resid="ChemDraft.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="ChemDraft.PowerPoint">
                <Label resid="ChemDraft.Label"/>
                <Icon>
                  <bt:Image size="16" resid="ChemDraft.Icon16"/>
                  <bt:Image size="32" resid="ChemDraft.Icon32"/>
                  <bt:Image size="80" resid="ChemDraft.Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="ChemDraft.PowerPoint.Open">
                  <Label resid="ChemDraft.Label"/>
                  <Supertip>
                    <Title resid="ChemDraft.Label"/>
                    <Description resid="ChemDraft.Description"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ChemDraft.Icon16"/>
                    <bt:Image size="32" resid="ChemDraft.Icon32"/>
                    <bt:Image size="80" resid="ChemDraft.Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ChemDraftEditStructure</TaskpaneId>
                    <SourceLocation resid="ChemDraft.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="ChemDraft.Icon16" DefaultValue="https://chemdraft.ai/office/{{AppVersion}}/icon-16.png"/>
        <bt:Image id="ChemDraft.Icon32" DefaultValue="https://chemdraft.ai/office/{{AppVersion}}/icon-32.png"/>
        <bt:Image id="ChemDraft.Icon80" DefaultValue="https://chemdraft.ai/office/{{AppVersion}}/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="ChemDraft.Url" DefaultValue="https://chemdraft.ai/office/{{AppVersion}}/taskpane"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="ChemDraft.Label" DefaultValue="Edit Structure"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ChemDraft.Description" DefaultValue="Edit the selected ChemDraft structure."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
