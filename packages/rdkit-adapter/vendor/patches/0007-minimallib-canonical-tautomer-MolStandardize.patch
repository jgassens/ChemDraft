+std::string JSMolBase::get_canonical_tautomer_molblock() const {
+  try {
+    RDKit::MolStandardize::TautomerEnumerator te;
+    std::unique_ptr<RDKit::ROMol> canonical(te.canonicalize(get()));
+    if (!canonical) {
+      return "";
+    }
+    RDKit::RWMol out(*canonical);
+    return MinimalLib::molblock_helper(out, "{}", MinimalLib::MDLVersion::V2000);
+  } catch (...) {
+    return "";
+  }
+}
 std::string JSMolBase::get_molblock(const std::string &details) const {
   return MinimalLib::molblock_helper(get(), details.c_str(),
                                      MinimalLib::MDLVersion::AUTO);
