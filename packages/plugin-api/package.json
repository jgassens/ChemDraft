{
  "name": "@chemdraft/plugin-api",
  "version": "0.1.0",
  "description": "The ChemDraft plugin SDK: manifest schema/validation, permission model, panel-report and worker-protocol contracts a plugin compiles against.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgassens/ChemDraft.git",
    "directory": "packages/plugin-api"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-sdk.mjs plugin-api"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
