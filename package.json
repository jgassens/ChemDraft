{
  "name": "chemdraft-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter @chemdraft/desktop dev",
    "dev:web": "pnpm --filter @chemdraft/desktop dev:web",
    "build": "pnpm lint && pnpm --filter @chemdraft/desktop build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "plugin:extract": "tsx tools/plugin-extract/extract.ts",
    "plugin:package": "tsx tools/plugin-package/package.ts",
    "audit:engine3d-sidecar": "node scripts/audit-avogadro3d-sidecar.mjs",
    "smoke:engine3d-real-structure": "node scripts/smoke-engine3d-real-structure.mjs",
    "smoke:engine3d-hold-steady": "node scripts/smoke-engine3d-hold-steady.mjs",
    "smoke:engine3d-anneal-energy": "node scripts/smoke-engine3d-anneal-energy.mjs",
    "test": "vitest run",
    "build:sdk": "node scripts/build-sdk.mjs plugin-api && node scripts/build-sdk.mjs plugin-host"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "^26.1.1",
    "esbuild": "^0.27.7",
    "jsdom": "^29.1.1",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
