{
  "version": 6,
  "configurePresets": [
    {
      "name": "protocol-scout",
      "displayName": "Protocol scout",
      "binaryDir": "${sourceDir}/build/protocol-scout",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CHEMDRAFT_AVOGADRO3D_USE_QT": "OFF",
        "CHEMDRAFT_AVOGADRO3D_USE_OPENGL": "OFF",
        "CHEMDRAFT_AVOGADRO3D_USE_AVOGADRO_CALC": "ON",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_DIAGNOSTIC_VIEWPORT": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_OPENBABEL": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_GPL_PLUGINS": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_PYTHON": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_TESTS": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_BENCHMARKS": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_PLOTTER": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_LIBARCHIVE": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_LIBMSYM": "OFF",
        "CHEMDRAFT_AVOGADRO3D_ENABLE_SPGLIB": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "protocol-scout",
      "configurePreset": "protocol-scout"
    }
  ]
}
