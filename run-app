#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$ROOT_DIR/apps/desktop"
DEV_HOST="127.0.0.1"
DEV_PORT="${CHEMDRAFT_DEV_PORT:-5173}"
RUN_MODE="${1:-app}"
# Which worktree/branch this launch is from. With several ChemDraft worktrees checked out (all
# building an app literally named "ChemDraft"), this is exported so the build bakes it into the
# window title (Rust option_env!) and the on-screen build stamp (vite), and it's printed in a banner
# at launch — so you can never again mistake which build is running. Auto-derived; see AGENTS.md.
CHEMDRAFT_WORKTREE_BRANCH="$(git -C "$ROOT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
CHEMDRAFT_WORKTREE_LABEL="$(basename "$ROOT_DIR")${CHEMDRAFT_WORKTREE_BRANCH:+ [$CHEMDRAFT_WORKTREE_BRANCH]}"
export CHEMDRAFT_WORKTREE_LABEL
# Populated by select_dev_sign_identity/resign_local_bundle so the banner can report what actually
# signed the bundle. Empty in --dev mode, where the bundle is never (re)signed.
RUN_APP_SIGN_IDENTITY=""
RUN_APP_SIGN_IDENTITY_DESC=""
LOCAL_ENGINE3D_SIDECAR="$ROOT_DIR/native/avogadro3d-sidecar/build/protocol-scout/avogadro3d-sidecar"
TAURI_OUTPUT_BUNDLE="$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft.app"
# /Applications/ChemDraft.app is the STABLE build from `main` and is never written, renamed, or
# unregistered by this script. Dev builds share one bundle id, app-data folder, and single-instance
# lock, separate from stable, with their own display name and bundles under <worktree>/app/.
# Before this split every build
# was stamped org.chemdraft.desktop and force-registered with LaunchServices, so a branch build
# impersonated the stable app — `open`, the Dock, and `tell application id` all resolved to whichever
# was registered last, and every build shared one ~/Library/Application Support/org.chemdraft.desktop
# (so two running builds fought over toolbar-state.json and clobbered each other's window positions).
STABLE_BUNDLE_ID="org.chemdraft.desktop"
# Shared so macOS permissions granted to ChemDraft (dev) apply across worktrees.
RUN_APP_BUNDLE_ID="${STABLE_BUNDLE_ID}.dev"
DEV_LAUNCH_LOCK="${TMPDIR:-/tmp}/${RUN_APP_BUNDLE_ID}.launch.lock"
DEV_LAUNCH_LOCK_HELD=0
DEV_LAUNCHER_PID=""
DEV_LAUNCHER_EXECUTABLE=""
DEV_LAUNCHER_OWNS_PROCESS_GROUP=0
RUN_APP_DISPLAY_NAME="ChemDraft (dev)"
RUN_APP_BUNDLE_DIR="$ROOT_DIR/app"
RUN_APP_BUNDLE="$RUN_APP_BUNDLE_DIR/$RUN_APP_DISPLAY_NAME.app"
LEGACY_RUN_APP_BUNDLE="$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft Run App.app"
LEGACY_RUN_APP_BUNDLE_ID="org.chemdraft.desktop.run-app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
DEV_APP_EXECUTABLE="$APP_DIR/src-tauri/target/debug/chemdraft"
RELEASE_APP_EXECUTABLE="$APP_DIR/src-tauri/target/release/chemdraft"
RUN_APP_EXECUTABLE="$RUN_APP_BUNDLE/Contents/MacOS/chemdraft"
RUN_APP_EXECUTABLE_PRODUCT_NAME="$RUN_APP_BUNDLE/Contents/MacOS/ChemDraft"
LEGACY_RUN_APP_EXECUTABLE="$LEGACY_RUN_APP_BUNDLE/Contents/MacOS/chemdraft"
LEGACY_RUN_APP_EXECUTABLE_PRODUCT_NAME="$LEGACY_RUN_APP_BUNDLE/Contents/MacOS/ChemDraft"

print_launch_banner() {
  local mode="$1"
  echo ""
  echo "============================================================"
  echo "  ChemDraft  ▸  $CHEMDRAFT_WORKTREE_LABEL"
  echo "  worktree:  $ROOT_DIR"
  echo "  mode:      $mode"
  # Printed so a launch is self-evidently NOT the stable /Applications app.
  echo "  bundle id: $RUN_APP_BUNDLE_ID"
  echo "  stable:    /Applications/ChemDraft.app ($STABLE_BUNDLE_ID) — untouched"
  if [ -n "$RUN_APP_SIGN_IDENTITY_DESC" ]; then
    echo "  signing:   $RUN_APP_SIGN_IDENTITY_DESC"
  fi
  echo "============================================================"
  echo ""
}

usage() {
  cat <<EOF
Usage: ./run-app [--dev]

Default: build and launch the ChemDraft macOS app bundle.
  --dev   launch Tauri dev mode with Vite/HMR.
EOF
}

if [ "$RUN_MODE" != "app" ] && [ "$RUN_MODE" != "--dev" ]; then
  usage
  exit 2
fi

process_cwd() {
  local pid="$1"

  # A process can disappear or belong to another user between pgrep/lsof. Under pipefail, that is an
  # expected empty result rather than a launcher-fatal error.
  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null \
    | sed -n 's/^n//p' \
    | awk 'NR == 1 { first = $0 } END { if (first != "") print first }' \
    || true
}

process_command() {
  local pid="$1"

  ps -p "$pid" -o command= 2>/dev/null | sed 's/^[[:space:]]*//' || true
}

process_executable() {
  local pid="$1"

  # The first text mapping reported by lsof is the executable itself. Unlike argv/pgrep -f this is
  # an exact filesystem path, so a checkout path mentioned merely as an argument cannot claim an
  # unrelated or sibling ChemDraft process.
  lsof -a -p "$pid" -d txt -Fn 2>/dev/null \
    | sed -n 's/^n//p' \
    | awk 'NR == 1 { first = $0 } END { if (first != "") print first }' \
    || true
}

stop_process() {
  local pid="$1"

  kill "$pid" 2>/dev/null || return 0
  for _ in {1..20}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    sleep 0.1
  done

  kill -9 "$pid" 2>/dev/null || true
}

process_bundle_identifier() {
  local executable="$1"
  case "$executable" in
    *.app/Contents/MacOS/*)
      /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
        "${executable%/Contents/MacOS/*}/Contents/Info.plist" 2>/dev/null || true
      ;;
  esac
}

release_dev_launch_lock() {
  if [ "$DEV_LAUNCH_LOCK_HELD" = "1" ]; then
    rm -f "$DEV_LAUNCH_LOCK/pid" "$DEV_LAUNCH_LOCK/checkout"
    rmdir "$DEV_LAUNCH_LOCK" 2>/dev/null || true
    DEV_LAUNCH_LOCK_HELD=0
  fi
}

launch_lock_directory_is_old() {
  local modified now
  modified="$(stat -c '%Y' "$1" 2>/dev/null)" || modified=""
  case "$modified" in
    "" | *[!0-9]*) modified="$(stat -f '%m' "$1" 2>/dev/null)" || modified="" ;;
  esac
  case "$modified" in "" | *[!0-9]*) return 1 ;; esac
  now="$(date +%s)"
  [ "$((now - modified))" -ge 10 ]
}

handle_dev_launch_signal() {
  # $! covers a signal arriving between starting the child and recording its PID. Ignore further
  # signals during this bounded handoff. Only the --dev child has a private process group;
  # packaged launches must keep running when we stop waiting for open -W.
  local status="$1" launcher_pid="$DEV_LAUNCHER_PID"
  trap '' INT TERM HUP
  if [ -z "$launcher_pid" ] && [ -n "$DEV_LAUNCHER_EXECUTABLE" ]; then
    # Bash 3.2 treats even ${!:-} as unbound before the first background job under set -u.
    launcher_pid="$(set +u; printf '%s' "$!")"
  fi
  if [ "$DEV_LAUNCHER_OWNS_PROCESS_GROUP" = "1" ] && [ -n "$launcher_pid" ]; then
    # Background jobs can ignore SIGINT. TERM the group created for our own npm child,
    # including its Tauri/Vite children, never a discovered app or another checkout.
    kill -TERM -- "-$launcher_pid" 2>/dev/null || true
    local started="$SECONDS"
    while kill -0 "$launcher_pid" 2>/dev/null; do
      [ "$((SECONDS - started))" -lt 60 ] || break
      sleep 0.1
    done
  elif [ "$DEV_LAUNCH_LOCK_HELD" = "1" ] && [ -n "$DEV_LAUNCHER_EXECUTABLE" ] && [ -n "$launcher_pid" ]; then
    wait_for_launched_app "$DEV_LAUNCHER_EXECUTABLE" "$launcher_pid" 60 || true
  fi
  exit "$status"
}

acquire_dev_launch_lock() {
  local owner_pid owner_checkout current_pid stale=0 reclaimed=0
  trap release_dev_launch_lock EXIT
  trap 'handle_dev_launch_signal 130' INT
  trap 'handle_dev_launch_signal 143' TERM
  trap 'handle_dev_launch_signal 129' HUP

  if ! mkdir "$DEV_LAUNCH_LOCK" 2>/dev/null; then
    owner_pid="$(cat "$DEV_LAUNCH_LOCK/pid" 2>/dev/null || true)"
    case "$owner_pid" in
      "")
        if [ ! -e "$DEV_LAUNCH_LOCK/pid" ] && launch_lock_directory_is_old "$DEV_LAUNCH_LOCK"; then
          stale=1
        fi
        ;;
      *[!0-9]* | 0) ;;
      *)
        if ! kill -0 "$owner_pid" 2>/dev/null; then
          stale=1
        fi
        ;;
    esac
    if [ "$stale" = "1" ]; then
      # An interrupted reclaimer can leave this empty directory behind. rmdir removes only an
      # empty, aged marker; a fresh marker still serializes contenders publishing ownership.
      if launch_lock_directory_is_old "$DEV_LAUNCH_LOCK/reclaim"; then
        rmdir "$DEV_LAUNCH_LOCK/reclaim" 2>/dev/null || true
      fi
      # Take ownership in place: removing/recreating the outer directory would let a delayed
      # stale contender remove a new owner's lock. Recheck the owner after acquiring the marker.
      if mkdir "$DEV_LAUNCH_LOCK/reclaim" 2>/dev/null; then
        current_pid="$(cat "$DEV_LAUNCH_LOCK/pid" 2>/dev/null || true)"
        if [ "$current_pid" = "$owner_pid" ]; then
          if [ -z "$current_pid" ]; then
            # mkdir changed the outer mtime, so use the age checked before taking the marker.
            [ -e "$DEV_LAUNCH_LOCK/pid" ] || reclaimed=1
          elif ! kill -0 "$current_pid" 2>/dev/null; then
            reclaimed=1
          fi
        fi
        if [ "$reclaimed" = "0" ]; then
          rmdir "$DEV_LAUNCH_LOCK/reclaim"
        fi
      fi
    fi
    # A fresh missing PID may mean the winner is still publishing its metadata. Fail closed.
    if [ "$reclaimed" = "0" ]; then
      owner_pid="$(cat "$DEV_LAUNCH_LOCK/pid" 2>/dev/null || true)"
      owner_checkout="$(cat "$DEV_LAUNCH_LOCK/checkout" 2>/dev/null || true)"
      echo "Refusing to launch: another run-app holds the dev launch lock (pid ${owner_pid:-unknown}):" >&2
      echo "  ${owner_checkout:-checkout metadata not yet available} ($DEV_LAUNCH_LOCK)" >&2
      return 1
    fi
  fi
  DEV_LAUNCH_LOCK_HELD=1
  printf '%s\n' "$$" >"$DEV_LAUNCH_LOCK/pid"
  printf '%s\n' "$ROOT_DIR" >"$DEV_LAUNCH_LOCK/checkout"
  if [ "$reclaimed" = "1" ]; then
    rmdir "$DEV_LAUNCH_LOCK/reclaim"
  fi
}

wait_for_launched_app() {
  local expected_executable="$1" launcher_pid="$2" timeout="${3:-0}" started="$SECONDS" pid pids
  # Tauri dev may still be compiling; keep the lock until the app is observable or its launcher
  # exits. Only interrupted launches use a time limit to bound signal handling.
  while true; do
    pids="$( { pgrep -x chemdraft 2>/dev/null || true; pgrep -x ChemDraft 2>/dev/null || true; } )"
    while IFS= read -r pid; do
      [ -n "$pid" ] || continue
      if [ "$(process_executable "$pid")" = "$expected_executable" ]; then
        release_dev_launch_lock
        return 0
      fi
    done <<< "$pids"
    if ! kill -0 "$launcher_pid" 2>/dev/null; then
      wait "$launcher_pid" || true
      echo "ChemDraft launch ended before its app process became visible." >&2
      return 1
    fi
    if [ "$timeout" -gt 0 ] && [ "$((SECONDS - started))" -ge "$timeout" ]; then
      return 1
    fi
    sleep 0.1
  done
}

assert_no_other_dev_app() {
  # A shared single-instance lock would silently hand this launch to the other checkout. Inspect
  # executable paths, never argv/cwd, and refuse before cleanup so a conflict kills nothing.
  # Bare target binaries have no bundle id: conservatively treat another checkout's as a dev build.
  # Unknown/unreadable executable identities are left alone, just as in stop_existing_dev_apps.
  local pid pids executable bundle_id other_dev
  pids="$(
    { pgrep -x chemdraft 2>/dev/null || true; }
    { pgrep -x ChemDraft 2>/dev/null || true; }
  )"
  while IFS= read -r pid; do
    [ -n "$pid" ] && [ "$pid" != "$$" ] || continue
    executable="$(process_executable "$pid")"
    case "$executable" in
      "" | "$DEV_APP_EXECUTABLE" | "$RELEASE_APP_EXECUTABLE" | \
      "$RUN_APP_EXECUTABLE" | "$RUN_APP_EXECUTABLE_PRODUCT_NAME" | \
      "$LEGACY_RUN_APP_EXECUTABLE" | "$LEGACY_RUN_APP_EXECUTABLE_PRODUCT_NAME" | \
      "$TAURI_OUTPUT_BUNDLE/Contents/MacOS/chemdraft" | \
      "$TAURI_OUTPUT_BUNDLE/Contents/MacOS/ChemDraft") continue ;;
    esac
    bundle_id="$(process_bundle_identifier "$executable")"
    # Even a stable build in another checkout's target/ must be left separate.
    [ "$bundle_id" != "$STABLE_BUNDLE_ID" ] || continue
    other_dev=0
    if [ "$bundle_id" = "$RUN_APP_BUNDLE_ID" ]; then
      other_dev=1
    elif [ -z "$bundle_id" ]; then
      case "$executable" in
        */app/*.app/Contents/MacOS/chemdraft | */app/*.app/Contents/MacOS/ChemDraft | \
        */target/debug/chemdraft | */target/release/chemdraft | \
        */target/release/bundle/macos/*.app/Contents/MacOS/chemdraft | \
        */target/release/bundle/macos/*.app/Contents/MacOS/ChemDraft) other_dev=1 ;;
      esac
    fi
    if [ "$other_dev" = "1" ]; then
      echo "Refusing to launch: another ChemDraft (dev) build is running (pid $pid):" >&2
      echo "  $executable" >&2
      echo "Dev builds share $RUN_APP_BUNDLE_ID and one single-instance lock." >&2
      echo "Quit that build before launching this worktree. No process was stopped by this check." >&2
      return 1
    fi
  done < <(printf "%s\n" "$pids" | awk 'NF && !seen[$0]++')
}

stop_existing_dev_apps() {
  if ! command -v pgrep >/dev/null 2>&1; then
    return 0
  fi

  # Stop only an executable at one of THIS checkout's exact build paths. Working directories and argv
  # mentions are useful diagnostics but are not ownership proof: another process can run from, or be
  # passed, a checkout path. Exact executable identity keeps sibling worktrees and ambiguous processes
  # alive. If lsof cannot establish identity, fail safe by leaving the process alone.
  local pid pids command executable belongs
  pids="$(
    { pgrep -x chemdraft 2>/dev/null || true; }
    { pgrep -x ChemDraft 2>/dev/null || true; }
  )"

  while IFS= read -r pid; do
    if [ -z "$pid" ]; then
      continue
    fi
    if [ "$pid" = "$$" ]; then
      continue
    fi

    command="$(process_command "$pid")"
    executable="$(process_executable "$pid")"
    belongs=0
    case "$executable" in
      "$DEV_APP_EXECUTABLE" | "$RELEASE_APP_EXECUTABLE" | \
      "$RUN_APP_EXECUTABLE" | "$RUN_APP_EXECUTABLE_PRODUCT_NAME" | \
      "$LEGACY_RUN_APP_EXECUTABLE" | "$LEGACY_RUN_APP_EXECUTABLE_PRODUCT_NAME") belongs=1 ;;
    esac

    if [ "$belongs" = "1" ]; then
      if [ -n "$command" ]; then
        echo "Stopping existing ChemDraft build from this checkout (pid $pid): $command"
      else
        echo "Stopping existing ChemDraft build from this checkout (pid $pid)."
      fi
      stop_process "$pid"
    fi
  done < <(printf "%s\n" "$pids" | awk 'NF && !seen[$0]++')
}

unregister_bundle() {
  local bundle="$1"

  if [ -x "$LSREGISTER" ] && [ -d "$bundle" ]; then
    "$LSREGISTER" -u "$bundle" >/dev/null 2>&1 || true
  fi
}

unregister_stale_chem_draft_bundles() {
  if [ -x "$LSREGISTER" ] && command -v mdfind >/dev/null 2>&1; then
    local bundle
    # Two sweeps, deliberately different in scope:
    #  - the shared dev id, anywhere, so launch-by-id selects this checkout's bundle;
    #  - the legacy run-app id, anywhere (nothing should answer to it any more).
    while IFS= read -r bundle; do
      if [ -z "$bundle" ] || [ "$bundle" = "$RUN_APP_BUNDLE" ]; then
        continue
      fi
      if [ -d "$bundle" ]; then
        echo "Unregistering stale ChemDraft app bundle: $bundle"
        unregister_bundle "$bundle"
      fi
    done < <(mdfind "kMDItemCFBundleIdentifier == \"$RUN_APP_BUNDLE_ID\" || kMDItemCFBundleIdentifier == \"$LEGACY_RUN_APP_BUNDLE_ID\"" 2>/dev/null || true)

    # A bundle carrying the STABLE id is only ours to touch when it sits inside this worktree —
    # a leftover `tauri build` output, which would otherwise shadow /Applications/ChemDraft.app in
    # LaunchServices. Anything outside this checkout (above all /Applications) is left alone.
    while IFS= read -r bundle; do
      case "$bundle" in
        "$ROOT_DIR"/*) ;;
        *) continue ;;
      esac
      if [ -d "$bundle" ]; then
        echo "Unregistering worktree build that claims the stable ChemDraft id: $bundle"
        unregister_bundle "$bundle"
      fi
    done < <(mdfind "kMDItemCFBundleIdentifier == \"$STABLE_BUNDLE_ID\"" 2>/dev/null || true)
  fi

  if [ -d "$LEGACY_RUN_APP_BUNDLE" ]; then
    echo "Removing legacy generated ChemDraft bundle: $LEGACY_RUN_APP_BUNDLE"
    unregister_bundle "$LEGACY_RUN_APP_BUNDLE"
    rm -rf "$LEGACY_RUN_APP_BUNDLE"
  fi
}

force_tauri_context_rebuild() {
  # `tauri::generate_context!()` bakes frontend assets, app icons, and other config-derived
  # resources into the Rust crate at compile time. Touching lib.rs forces Cargo to rebuild that
  # context so dev and packaged launches do not reuse stale app identity assets.
  touch "$APP_DIR/src-tauri/src/lib.rs"
}

tauri_context_fingerprint() {
  if ! command -v shasum >/dev/null 2>&1; then
    return 1
  fi

  shasum \
    "$APP_DIR/src-tauri/tauri.conf.json" \
    "$APP_DIR/src-tauri/Cargo.toml" \
    "$APP_DIR/src-tauri/icons/icon.png" \
    | shasum \
    | awk '{print $1}'
}

prime_tauri_context_rebuild_for_dev() {
  local fingerprint fingerprint_file previous_fingerprint
  fingerprint_file="$APP_DIR/src-tauri/target/.chemdraft-tauri-context.sha"

  if ! fingerprint="$(tauri_context_fingerprint)"; then
    echo "Could not fingerprint Tauri app identity assets; clearing cached ChemDraft context."
    (
      cd "$APP_DIR/src-tauri"
      cargo clean -p chemdraft >/dev/null
    )
    return 0
  fi

  previous_fingerprint=""
  if [ -f "$fingerprint_file" ]; then
    previous_fingerprint="$(cat "$fingerprint_file" 2>/dev/null || true)"
  fi

  if [ "$fingerprint" = "$previous_fingerprint" ]; then
    return 0
  fi

  echo "Tauri app identity assets changed; clearing cached ChemDraft context."
  (
    cd "$APP_DIR/src-tauri"
    cargo clean -p chemdraft >/dev/null
  )
  mkdir -p "$(dirname "$fingerprint_file")"
  printf "%s\n" "$fingerprint" >"$fingerprint_file"
}

stop_existing_dev_server() {
  local port="${1:-$DEV_PORT}"
  local unrelated_mode="${2:-strict}"

  if ! command -v lsof >/dev/null 2>&1; then
    return 0
  fi

  local cwd pid pids
  pids="$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true)"
  for pid in $pids; do
    cwd="$(process_cwd "$pid")"
    case "$cwd" in
      "$ROOT_DIR"|"$ROOT_DIR"/*)
        echo "Stopping existing ChemDraft dev server on $DEV_HOST:$port (process $pid)."
        stop_process "$pid"
        ;;
      *)
        echo "Port $port is already in use by process $pid."
        if [ -n "$cwd" ]; then
          echo "That process is running from: $cwd"
        fi
        echo "It does not look like this ChemDraft checkout, so ./run-app will not kill it."
        if [ "$unrelated_mode" = "ignore-unrelated" ]; then
          return 0
        fi
        exit 1
        ;;
    esac
  done
}

stop_stale_dev_servers_for_this_checkout() {
  # select_dev_port stops scanning at the FIRST free port, so a same-checkout dev server left
  # running on a higher port from an earlier `--dev` session (one you forgot to close) is never
  # even inspected, let alone stopped — it just orphans forever and the next run picks a new port
  # instead of reclaiming the old one. Sweep the same candidate range unconditionally, in both
  # launch modes, so leftovers from this checkout are always reaped before anything else runs.
  local candidate start
  start="$DEV_PORT"
  for ((candidate = start; candidate <= start + 20; candidate++)); do
    stop_existing_dev_server "$candidate" ignore-unrelated
  done
}

select_dev_port() {
  if ! command -v lsof >/dev/null 2>&1; then
    export CHEMDRAFT_DEV_PORT="$DEV_PORT"
    echo "Using ChemDraft dev server port $DEV_PORT."
    return 0
  fi

  local candidate cwd has_unrelated pid pids start
  start="$DEV_PORT"
  for ((candidate = start; candidate <= start + 20; candidate++)); do
    pids="$(lsof -tiTCP:"$candidate" -sTCP:LISTEN 2>/dev/null || true)"
    if [ -z "$pids" ]; then
      DEV_PORT="$candidate"
      export CHEMDRAFT_DEV_PORT="$DEV_PORT"
      echo "Using ChemDraft dev server port $DEV_PORT."
      return 0
    fi

    has_unrelated=0
    for pid in $pids; do
      cwd="$(process_cwd "$pid")"
      case "$cwd" in
        "$ROOT_DIR"|"$ROOT_DIR"/*)
          echo "Stopping existing ChemDraft dev server on $DEV_HOST:$candidate (process $pid)."
          stop_process "$pid"
          ;;
        *)
          has_unrelated=1
          echo "Port $candidate is already in use by process $pid."
          if [ -n "$cwd" ]; then
            echo "That process is running from: $cwd"
          fi
          echo "Trying the next port for ChemDraft."
          ;;
      esac
    done

    if [ "$has_unrelated" = "0" ]; then
      DEV_PORT="$candidate"
      export CHEMDRAFT_DEV_PORT="$DEV_PORT"
      echo "Using ChemDraft dev server port $DEV_PORT."
      return 0
    fi
  done

  echo "Could not find a free ChemDraft dev server port from $start through $((start + 20))."
  exit 1
}

clear_saved_window_state() {
  # Scoped to the shared dev id (and the dead legacy id). Clearing the stable id here would
  # throw away the window state of /Applications/ChemDraft.app, which this script does not own.
  local saved_state_dir="$HOME/Library/Saved Application State/$RUN_APP_BUNDLE_ID.savedState"
  local legacy_run_app_saved_state_dir="$HOME/Library/Saved Application State/$LEGACY_RUN_APP_BUNDLE_ID.savedState"

  if [ -d "$saved_state_dir" ]; then
    rm -rf "$saved_state_dir"
  fi
  if [ -d "$legacy_run_app_saved_state_dir" ]; then
    rm -rf "$legacy_run_app_saved_state_dir"
  fi

  defaults delete "$RUN_APP_BUNDLE_ID" NSQuitAlwaysKeepsWindows >/dev/null 2>&1 || true
  defaults delete "$LEGACY_RUN_APP_BUNDLE_ID" NSQuitAlwaysKeepsWindows >/dev/null 2>&1 || true
}

set_bundle_display_name() {
  local bundle="$1"
  local display_name="$2"
  local plist="$bundle/Contents/Info.plist"

  if [ ! -f "$plist" ]; then
    return 0
  fi

  plist_set_or_add_string "$plist" CFBundleName "$display_name"
  plist_set_or_add_string "$plist" CFBundleDisplayName "$display_name"
  plist_set_or_add_string "$plist" CFBundleIdentifier "$RUN_APP_BUNDLE_ID"
  /usr/libexec/PlistBuddy -c "Delete :LSRequiresCarbon" "$plist" >/dev/null 2>&1 || true
  plist_set_or_add_string "$plist" NSPrincipalClass NSApplication

  # A branch build must never follow the PRODUCTION update feed. That appcast ships
  # org.chemdraft.desktop builds; once it advances past this branch's version, Sparkle would offer
  # this dev app an update whose bundle identity differs — the install fails validation, or worse
  # replaces the branch build and defeats the whole identity split. Strip the feed and disable
  # scheduled checks; a dev feed would be safe only if it published this exact dev bundle id.
  /usr/libexec/PlistBuddy -c "Delete :SUFeedURL" "$plist" >/dev/null 2>&1 || true
  if ! /usr/libexec/PlistBuddy -c "Set :SUEnableAutomaticChecks false" "$plist" >/dev/null 2>&1; then
    /usr/libexec/PlistBuddy -c "Add :SUEnableAutomaticChecks bool false" "$plist" >/dev/null 2>&1 || true
  fi
}

plist_set_or_add_string() {
  local plist="$1"
  local key="$2"
  local value="$3"

  if ! /usr/libexec/PlistBuddy -c "Set :$key $value" "$plist" >/dev/null 2>&1; then
    /usr/libexec/PlistBuddy -c "Add :$key string $value" "$plist" >/dev/null 2>&1 || true
  fi
}

stage_run_app_bundle() {
  if [ ! -d "$TAURI_OUTPUT_BUNDLE" ]; then
    echo "Tauri build did not produce the expected app bundle:"
    echo "$TAURI_OUTPUT_BUNDLE"
    exit 1
  fi

  if [ "$TAURI_OUTPUT_BUNDLE" = "$RUN_APP_BUNDLE" ]; then
    return 0
  fi

  if [ -e "$RUN_APP_BUNDLE" ]; then
    rm -rf "$RUN_APP_BUNDLE"
  fi

  # Move rather than copy: `tauri build` stamps its output with the STABLE id, and a copy left
  # behind in target/ would keep shadowing /Applications/ChemDraft.app in LaunchServices.
  mkdir -p "$RUN_APP_BUNDLE_DIR"
  mv "$TAURI_OUTPUT_BUNDLE" "$RUN_APP_BUNDLE"
}

assert_stable_app_untouched() {
  # A cheap tripwire for the one invariant this script must never break: whatever is installed in
  # /Applications belongs to `main` and is not ours to build over.
  case "$RUN_APP_BUNDLE" in
    /Applications/*)
      echo "Refusing to stage a worktree build into /Applications."
      echo "That path is reserved for the stable build from main."
      exit 1
      ;;
  esac
  if [ "$RUN_APP_BUNDLE_ID" = "$STABLE_BUNDLE_ID" ]; then
    echo "Refusing to launch: this worktree build would claim the stable bundle id"
    echo "$STABLE_BUNDLE_ID, which belongs to /Applications/ChemDraft.app."
    exit 1
  fi
}

strip_bundle_detritus() {
  local bundle="$1"

  # This repo lives under ~/Documents, which macOS syncs via the iCloud File Provider. That
  # provider stamps com.apple.FinderInfo / com.apple.fileprovider.fpfs xattrs onto freshly
  # built files (including the .app bundle), and codesign then refuses to sign with:
  #   "resource fork, Finder information, or similar detritus not allowed".
  # Stripping all extended attributes immediately before signing avoids that. (The real
  # long-term fix is to keep the checkout outside an iCloud-synced folder.)
  if command -v xattr >/dev/null 2>&1; then
    xattr -cr "$bundle" 2>/dev/null || true
  fi
}

# macOS keys privacy grants (Screen Recording, etc.) to the app's code-signing identity, not its
# bundle id. An ad-hoc signature (identity "-") is derived fresh from the binary's own contents each
# time, so every rebuild is a new identity as far as TCC is concerned: System Settings is left
# showing a stale, still-"on" entry for the previous build, and the new build can never be granted
# access through it. Signing with a stable identity across rebuilds lets the grant carry over.
select_dev_sign_identity() {
  if [ -n "${CHEMDRAFT_DEV_SIGN_IDENTITY:-}" ]; then
    RUN_APP_SIGN_IDENTITY="$CHEMDRAFT_DEV_SIGN_IDENTITY"
    RUN_APP_SIGN_IDENTITY_DESC="$CHEMDRAFT_DEV_SIGN_IDENTITY (\$CHEMDRAFT_DEV_SIGN_IDENTITY)"
    return 0
  fi

  if command -v security >/dev/null 2>&1; then
    # Select by SHA-1 hash, not by the common name: this machine has several identities all named
    # "Apple Development: ...", and signing by name lets codesign pick an unpredictable one of them.
    local hash
    # `|| true`: with no Apple Development identity grep exits 1, and under `set -euo pipefail`
    # the failed assignment would end the script here instead of reaching the ad-hoc fallback.
    hash="$(security find-identity -v -p codesigning 2>/dev/null \
      | grep '"Apple Development:' | head -n1 | awk '{print $2}' || true)"
    if [ -n "$hash" ]; then
      RUN_APP_SIGN_IDENTITY="$hash"
      RUN_APP_SIGN_IDENTITY_DESC="$hash (Apple Development, from keychain)"
      return 0
    fi
  fi

  RUN_APP_SIGN_IDENTITY=""
  RUN_APP_SIGN_IDENTITY_DESC="ad-hoc (no Apple Development identity found; permissions will not survive rebuilds)"
}

resign_local_bundle() {
  local bundle="$1"

  strip_bundle_detritus "$bundle"
  if ! command -v codesign >/dev/null 2>&1; then
    return 0
  fi

  select_dev_sign_identity

  if [ -n "$RUN_APP_SIGN_IDENTITY" ]; then
    # Same flags as the ad-hoc path below, apart from the identity: no --options runtime. Hardened
    # runtime would need its own entitlements for the webview's JIT, which dev builds don't carry,
    # so turning it on here would just break the app rather than help it.
    if codesign --force --deep --sign "$RUN_APP_SIGN_IDENTITY" "$bundle" >/dev/null 2>&1; then
      return 0
    fi
    echo "Signing with $RUN_APP_SIGN_IDENTITY_DESC failed (e.g. keychain locked); falling back to ad-hoc."
    echo "Screen Recording and similar permission grants will not survive the next rebuild."
    RUN_APP_SIGN_IDENTITY=""
    RUN_APP_SIGN_IDENTITY_DESC="ad-hoc (stable-identity signing failed; permissions will not survive rebuilds)"
  fi

  codesign --force --deep --sign - "$bundle" >/dev/null
}

launch_bundle() {
  local bundle="$1"

  # On newer macOS builds, LaunchServices can keep stale metadata for repeatedly rebuilt
  # unsigned development bundles and then report kLSNoExecutableErr even when
  # Contents/MacOS/$CFBundleExecutable exists and codesign verifies. Register the exact bundle
  # path just before opening so ./run-app does not accidentally launch another checkout with the
  # same bundle id or fail against stale cache state.
  if [ -x "$LSREGISTER" ]; then
    "$LSREGISTER" -f "$bundle" >/dev/null 2>&1 || true
  fi

  # -W lets us observe launch failure/early exit without mistaking a slow asynchronous launch
  # for failure and releasing the shared lock too soon. It may outlive run-app after success.
  local executable
  executable="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$bundle/Contents/Info.plist")"
  DEV_LAUNCHER_EXECUTABLE="$bundle/Contents/MacOS/$executable"
  open -W "$bundle" &
  local launcher_pid=$!
  DEV_LAUNCHER_PID="$launcher_pid"
  wait_for_launched_app "$bundle/Contents/MacOS/$executable" "$launcher_pid"
}

activate_launched_bundle() {
  if ! command -v osascript >/dev/null 2>&1; then
    return 0
  fi

  for _ in {1..30}; do
    if osascript \
      -e "tell application id \"$RUN_APP_BUNDLE_ID\" to activate" \
      -e "tell application \"System Events\" to tell (first process whose bundle identifier is \"$RUN_APP_BUNDLE_ID\") to set frontmost to true" \
      >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  echo "ChemDraft launched, but macOS did not report it as foreground yet."
  echo "If the window is not active, click $RUN_APP_DISPLAY_NAME once or run ./run-app again."
}

cd "$ROOT_DIR"

acquire_dev_launch_lock
assert_no_other_dev_app

if [ ! -d "$ROOT_DIR/node_modules" ] || [ ! -d "$APP_DIR/node_modules" ]; then
  if command -v pnpm >/dev/null 2>&1; then
    pnpm install
  else
    npx pnpm install
  fi
fi

cd "$APP_DIR"

if ! command -v cargo >/dev/null 2>&1; then
  if [ -x "$HOME/.cargo/bin/cargo" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
  fi
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "ChemDraft now launches through Tauri, but Rust/Cargo is not installed or not on PATH."
  echo "Install Rust from https://rustup.rs/, then run ./run-app again."
  exit 1
fi

"$ROOT_DIR/scripts/prepare-sparkle.sh"

assert_stable_app_untouched
stop_existing_dev_apps
unregister_stale_chem_draft_bundles
stop_stale_dev_servers_for_this_checkout

if [ -z "${CHEMDRAFT_ENGINE3D_SIDECAR:-}" ] && [ -x "$LOCAL_ENGINE3D_SIDECAR" ]; then
  export CHEMDRAFT_ENGINE3D_SIDECAR="$LOCAL_ENGINE3D_SIDECAR"
  echo "Using local Engine 3D sidecar: $CHEMDRAFT_ENGINE3D_SIDECAR"
fi

if [ "$RUN_MODE" = "--dev" ]; then
  select_dev_port
  prime_tauri_context_rebuild_for_dev
  print_launch_banner "dev (Vite HMR)"
  # Same shared dev app_data_dir and lock as the packaged path, separate from stable.
  # dev:tauri merges this into its --config.
  export CHEMDRAFT_DEV_BUNDLE_ID="$RUN_APP_BUNDLE_ID"
  assert_no_other_dev_app
  DEV_LAUNCHER_EXECUTABLE="$DEV_APP_EXECUTABLE"
  DEV_LAUNCHER_OWNS_PROCESS_GROUP=1
  # Enable job control only for the spawn so cancellation can target this launch's process
  # group; disable it before foreground waits, and keep Vite from reading the terminal.
  set -m
  npm run dev:tauri </dev/null &
  dev_launcher_pid=$!
  set +m
  DEV_LAUNCHER_PID="$dev_launcher_pid"
  wait_for_launched_app "$DEV_APP_EXECUTABLE" "$dev_launcher_pid"
  wait "$dev_launcher_pid"
  exit $?
fi

stop_existing_dev_server "$DEV_PORT" ignore-unrelated

if [ -e "$RUN_APP_BUNDLE" ]; then
  rm -rf "$RUN_APP_BUNDLE"
fi
if [ -e "$TAURI_OUTPUT_BUNDLE" ]; then
  rm -rf "$TAURI_OUTPUT_BUNDLE"
fi

force_tauri_context_rebuild

# The identifier must be overridden at BUILD time, not patched into Info.plist afterwards:
# `generate_context!()` bakes it in at compile time and Tauri derives app_data_dir() from it. Patching
# only the plist would give the bundle a separate LaunchServices identity while it kept reading and
# writing ~/Library/Application Support/org.chemdraft.desktop — still fighting the stable app over
# toolbar-state.json, which is the whole thing this split exists to stop.
node_modules/.bin/tauri build --bundles app --config "{\"identifier\":\"$RUN_APP_BUNDLE_ID\"}"
set_bundle_display_name "$TAURI_OUTPUT_BUNDLE" "$RUN_APP_DISPLAY_NAME"
stage_run_app_bundle
resign_local_bundle "$RUN_APP_BUNDLE"
clear_saved_window_state

print_launch_banner "packaged app"
echo "Launching $RUN_APP_DISPLAY_NAME from $RUN_APP_BUNDLE"
assert_no_other_dev_app
launch_bundle "$RUN_APP_BUNDLE"
activate_launched_bundle
