#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$ROOT_DIR/apps/desktop"
DEV_HOST="127.0.0.1"
DEV_PORT="5173"
RUN_MODE="${1:-app}"
TAURI_OUTPUT_BUNDLE="$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft.app"
RUN_APP_BUNDLE="$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft Run App.app"
RUN_APP_BUNDLE_ID="org.chemdraft.desktop.run-app"
RUN_APP_DISPLAY_NAME="ChemDraft Run App"

usage() {
  cat <<EOF
Usage: ./run-app [--dev]

Default: build and launch the inspectable macOS app bundle.
  --dev   launch Tauri dev mode with Vite/HMR.
EOF
}

if [ "$RUN_MODE" != "app" ] && [ "$RUN_MODE" != "--dev" ]; then
  usage
  exit 2
fi

process_cwd() {
  local pid="$1"

  lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
}

stop_process() {
  local pid="$1"

  kill "$pid" 2>/dev/null || return 0
  for _ in {1..20}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    sleep 0.1
  done

  kill -9 "$pid" 2>/dev/null || true
}

stop_existing_dev_apps() {
  if ! command -v pgrep >/dev/null 2>&1; then
    return 0
  fi

  local pattern pid pids
  for pattern in \
    "target/debug/chemdraft" \
    "target/release/chemdraft" \
    "$APP_DIR/src-tauri/target/debug/chemdraft" \
    "$APP_DIR/src-tauri/target/release/chemdraft" \
    "$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft.app/Contents/MacOS/chemdraft" \
    "$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft Run App.app/Contents/MacOS/chemdraft" \
    "$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft-working-draft.app/Contents/MacOS/chemdraft" \
    "$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft-pre-scena-snapshot.app/Contents/MacOS/chemdraft" \
    "$APP_DIR/src-tauri/target/release/bundle/macos/ChemDraft-release-snapshot.app/Contents/MacOS/chemdraft"; do
    pids="$(pgrep -f "$pattern" 2>/dev/null || true)"
    for pid in $pids; do
      if [ "$pid" != "$$" ]; then
        echo "Stopping existing ChemDraft dev app process $pid."
        stop_process "$pid"
      fi
    done
  done
}

stop_existing_dev_server() {
  local unrelated_mode="${1:-strict}"

  if ! command -v lsof >/dev/null 2>&1; then
    return 0
  fi

  local cwd pid pids
  pids="$(lsof -tiTCP:"$DEV_PORT" -sTCP:LISTEN 2>/dev/null || true)"
  for pid in $pids; do
    cwd="$(process_cwd "$pid")"
    case "$cwd" in
      "$ROOT_DIR"|"$ROOT_DIR"/*)
        echo "Stopping existing ChemDraft dev server on $DEV_HOST:$DEV_PORT (process $pid)."
        stop_process "$pid"
        ;;
      *)
        echo "Port $DEV_PORT is already in use by process $pid."
        if [ -n "$cwd" ]; then
          echo "That process is running from: $cwd"
        fi
        echo "It does not look like this ChemDraft checkout, so ./run-app will not kill it."
        if [ "$unrelated_mode" = "ignore-unrelated" ]; then
          return 0
        fi
        exit 1
        ;;
    esac
  done
}

clear_saved_window_state() {
  local saved_state_dir="$HOME/Library/Saved Application State/org.chemdraft.desktop.savedState"
  local run_app_saved_state_dir="$HOME/Library/Saved Application State/$RUN_APP_BUNDLE_ID.savedState"

  if [ -d "$saved_state_dir" ]; then
    rm -rf "$saved_state_dir"
  fi
  if [ -d "$run_app_saved_state_dir" ]; then
    rm -rf "$run_app_saved_state_dir"
  fi

  defaults delete org.chemdraft.desktop NSQuitAlwaysKeepsWindows >/dev/null 2>&1 || true
  defaults delete "$RUN_APP_BUNDLE_ID" NSQuitAlwaysKeepsWindows >/dev/null 2>&1 || true
}

set_bundle_display_name() {
  local bundle="$1"
  local display_name="$2"
  local plist="$bundle/Contents/Info.plist"

  if [ ! -f "$plist" ]; then
    return 0
  fi

  plist_set_or_add_string "$plist" CFBundleName "$display_name"
  plist_set_or_add_string "$plist" CFBundleDisplayName "$display_name"
  plist_set_or_add_string "$plist" CFBundleIdentifier "$RUN_APP_BUNDLE_ID"
  /usr/libexec/PlistBuddy -c "Delete :LSRequiresCarbon" "$plist" >/dev/null 2>&1 || true
  plist_set_or_add_string "$plist" NSPrincipalClass NSApplication
}

plist_set_or_add_string() {
  local plist="$1"
  local key="$2"
  local value="$3"

  if ! /usr/libexec/PlistBuddy -c "Set :$key $value" "$plist" >/dev/null 2>&1; then
    /usr/libexec/PlistBuddy -c "Add :$key string $value" "$plist" >/dev/null 2>&1 || true
  fi
}

stage_run_app_bundle() {
  if [ ! -d "$TAURI_OUTPUT_BUNDLE" ]; then
    echo "Tauri build did not produce the expected app bundle:"
    echo "$TAURI_OUTPUT_BUNDLE"
    exit 1
  fi

  if [ -e "$RUN_APP_BUNDLE" ]; then
    rm -rf "$RUN_APP_BUNDLE"
  fi

  mv "$TAURI_OUTPUT_BUNDLE" "$RUN_APP_BUNDLE"
}

resign_local_bundle() {
  local bundle="$1"

  if command -v codesign >/dev/null 2>&1; then
    codesign --force --deep --sign - "$bundle" >/dev/null
  fi
}

launch_bundle() {
  local bundle="$1"

  if ! open -n "$bundle"; then
    echo "macOS open failed. The bundle was built, but LaunchServices refused to open it."
    echo "Check for stale ChemDraft processes, then run ./run-app again."
    exit 1
  fi
}

activate_launched_bundle() {
  if ! command -v osascript >/dev/null 2>&1; then
    return 0
  fi

  for _ in {1..30}; do
    if osascript \
      -e "tell application id \"$RUN_APP_BUNDLE_ID\" to activate" \
      -e "tell application \"System Events\" to tell (first process whose bundle identifier is \"$RUN_APP_BUNDLE_ID\") to set frontmost to true" \
      >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  echo "ChemDraft launched, but macOS did not report it as foreground yet."
  echo "If the window is not active, click $RUN_APP_DISPLAY_NAME once or run ./run-app again."
}

cd "$ROOT_DIR"

if [ ! -d "$ROOT_DIR/node_modules" ] || [ ! -d "$APP_DIR/node_modules" ]; then
  if command -v pnpm >/dev/null 2>&1; then
    pnpm install
  else
    npx pnpm install
  fi
fi

cd "$APP_DIR"

if ! command -v cargo >/dev/null 2>&1; then
  if [ -x "$HOME/.cargo/bin/cargo" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
  fi
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "ChemDraft now launches through Tauri, but Rust/Cargo is not installed or not on PATH."
  echo "Install Rust from https://rustup.rs/, then run ./run-app again."
  exit 1
fi

stop_existing_dev_apps

if [ "$RUN_MODE" = "--dev" ]; then
  stop_existing_dev_server strict
  exec npm run dev
fi

stop_existing_dev_server ignore-unrelated

if [ -e "$RUN_APP_BUNDLE" ]; then
  rm -rf "$RUN_APP_BUNDLE"
fi
if [ -e "$TAURI_OUTPUT_BUNDLE" ]; then
  rm -rf "$TAURI_OUTPUT_BUNDLE"
fi

# Force Tauri to re-embed the freshly built frontend. `tauri::generate_context!()` in
# src-tauri/src/lib.rs bakes the built `dist/` into the binary at COMPILE time. cargo's
# incremental build can relink the binary (updating its mtime) while reusing a cached lib.rs
# object that still embeds STALE frontend assets whenever only the frontend changed and no Rust
# source did. Bumping lib.rs's mtime forces that crate — and the asset embed — to recompile, so
# `./run-app` always launches the current frontend.
touch "$APP_DIR/src-tauri/src/lib.rs"

node_modules/.bin/tauri build --bundles app
set_bundle_display_name "$TAURI_OUTPUT_BUNDLE" "$RUN_APP_DISPLAY_NAME"
stage_run_app_bundle
resign_local_bundle "$RUN_APP_BUNDLE"
clear_saved_window_state

echo "Launching $RUN_APP_DISPLAY_NAME from $RUN_APP_BUNDLE"
launch_bundle "$RUN_APP_BUNDLE"
activate_launched_bundle
