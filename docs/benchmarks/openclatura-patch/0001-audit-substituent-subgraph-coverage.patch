@@ -1425,6 +1426,19 @@ def name_subgraph(
         parent_selection.is_polycycle,
     )
 
+    # A substituent must account for its whole subgraph, exactly as a component must.
+    #
+    # Without this, a branch containing a feature the namer cannot express is rendered without it,
+    # while `SubstituentItem.atom_ids` still claims every atom in the branch -- so the component-level
+    # `assert_component_fully_named` is satisfied by an over-claiming binding and the omission passes
