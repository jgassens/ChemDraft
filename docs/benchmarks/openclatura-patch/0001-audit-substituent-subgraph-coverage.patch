+@pytest.mark.parametrize(
+    "smiles",
+    [
+        # An arsonic acid group on a substituent ring. Before the subgraph audit these produced
+        # confident, OPSIN-parseable names for the molecule MINUS the arsenic, e.g.
+        # "2-(phenylamino)acetamide" for the first entry.
+        "NC(=O)CNc1ccc([As](=O)(O)O)cc1",
+        "CC(=O)Nc1cc([As](=O)(O)O)ccc1O",
+        "O=S(=O)(O)c1ccc(-c2ccc([As](=O)(O)O)cc2)cc1",
+        "CN(C)c1ccc(N=Nc2ccc([As](=O)(O)O)cc2)cc1",
+        "NC(=O)CNCc1ccc([As]=O)cc1",
+    ],
+)
+def test_unnameable_substituent_declines_instead_of_dropping_atoms(smiles):
+    """A fragment the namer cannot express must not be silently omitted from the name.
+
+    The same arsonic acid as a PARENT already declined; only the substituent path let it through,
+    because the SubstituentItem claimed every atom in the branch regardless of what its name covered.
+    """
+
+    result = DEFAULT_NAMING_ENGINE.run(NamingRequest(smiles=smiles))
+    assert result.name == ""
+    assert "UnnamedAtomError" in (result.error or "")
+
+
+def test_subgraph_coverage_audit_rejects_unnamed_branch_atoms():
+    mol = Molecule()
+    mol.add_atom("C", 0)
+    mol.add_atom("O", 1)
+    parts = AssemblyParts(parent_length=1, parent_atom_ids={0})
+
+    with pytest.raises(UnnamedAtomError):
+        assert_subgraph_fully_named(mol, {0, 1}, parts)
+
+
+def test_subgraph_coverage_audit_accepts_a_fully_named_branch():
+    mol = Molecule()
+    mol.add_atom("C", 0)
+    mol.add_atom("C", 1)
+    parts = AssemblyParts(parent_length=2, parent_atom_ids={0, 1})
+
+    assert_subgraph_fully_named(mol, {0, 1}, parts)
+
+
+def test_substituent_audit_leaves_ordinary_names_alone():
+    """The audit must not cost coverage: these all name normally and must keep doing so."""
+
+    assert name_smiles("CC(=O)Oc1ccccc1C(=O)O") == "2-(acetoxy)benzoic acid"
+    assert name_smiles("c1ccccc1") == "benzene"
+    assert name_smiles("CCO") == "ethanol"
+
+
 def test_typed_shortcut_results_return_none_on_out_of_component_neighbors():
     phosphinic = Molecule()
     phosphinic.add_atom("P", 0, explicit_h_count=1)
