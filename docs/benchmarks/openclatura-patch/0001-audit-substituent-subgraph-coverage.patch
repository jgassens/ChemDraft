+    # NC(=O)CNc1ccc([As](=O)(O)O)cc1 -> "2-(phenylamino)acetamide". The same arsonic acid as a PARENT
+    # already raises UnnamedAtomError, so this applies one existing rule one level deeper.
+    #
+    # The shortcut paths above (heteroatom-subgraph renderer, direct functional prefix) need no check:
+    # each matches the complete component by construction.
+    assert_subgraph_fully_named(mol, set(component), parts)
+
     rendered_name = _assemble_parent_name(
         mol,
         parts,
diff --git a/src/openclatura/naming_audit.py b/src/openclatura/naming_audit.py
index 4215f4e..385b30a 100644
--- a/src/openclatura/naming_audit.py
+++ b/src/openclatura/naming_audit.py
@@ -50,6 +50,46 @@ def component_named_atom_coverage(mol: Molecule, component_atoms: set[int], part
     )
 
 
+def consumed_atom_ids(parts: AssemblyParts) -> set[int]:
+    """Return the atoms the assembled parts account for, without rebuilding name bindings.
+
+    The mirror of ``name_assembly._consumed_bond_ids``. Reading the ``atom_ids`` already carried by
+    each part is enough to tell whether a fragment was left out, and costs nothing next to
+    ``refresh_name_atom_bindings`` -- which matters because the substituent audit runs on every branch
+    of every molecule, where rebuilding bindings measured ~45% slower over 5k structures.
+    """
+
+    atoms: set[int] = set(parts.parent_atom_ids)
+    atoms.update(parts.front_modifier_atom_ids)
+    for group in (
+        parts.principal_suffix_modifiers,
+        parts.a_prefixes,
+        parts.substituents,
+        parts.unsaturations,
+    ):
+        for item in group:
+            atoms.update(item.atom_ids)
+    if parts.principal_group is not None:
+        atoms.update(parts.principal_group.atom_ids)
+    return atoms
+
+
+def assert_subgraph_fully_named(mol: Molecule, component_atoms: set[int], parts: AssemblyParts) -> None:
+    """Raise if a substituent's assembled parts do not account for its whole subgraph.
+
+    A substituent must cover its own atoms for the same reason a component must: a branch containing a
+    feature the namer cannot express is otherwise rendered without it, while the ``SubstituentItem``
+    built from it still claims every atom in the branch -- which satisfies the component-level audit
+    with an over-claiming binding and lets the omission through silently.
+    """
+
+    explicit = {idx for idx in component_atoms if mol.atoms[idx].symbol != "H"}
+    unnamed = explicit - consumed_atom_ids(parts)
+    if unnamed:
+        details = ", ".join(f"{idx}:{mol.atoms[idx].symbol}" for idx in sorted(unnamed))
+        raise UnnamedAtomError(f"Generated substituent name left unnamed atoms: {details}")
+
+
 def assert_component_fully_named(mol: Molecule, component_atoms: set[int], parts: AssemblyParts, name: str) -> None:
     """Raise if a generated component name did not consume all graph atoms."""
 
